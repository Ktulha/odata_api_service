# --- приложение ---
ODATA_DEBUG=false

# --- база данных кеша: PostgreSQL или SQLite (по умолчанию SQLite для разработки) ---
ODATA_DATABASE_URL=postgresql+psycopg://app:secret@localhost:5432/odata_cache
# ODATA_DATABASE_URL=sqlite:///./odata_cache.db

# --- 1С OData: ТОЛЬКО для роли worker (в api-процессе задавать не нужно) ---
ODATA_ONEDATA_BASE_URL=https://1c.example.ru/OData/MyBase
ODATA_ONEDATA_USERNAME=sync_user
ODATA_ONEDATA_PASSWORD=change-me
ODATA_ONEDATA_TIMEOUT=30

# --- worker / планировщик ---
ODATA_SYNC_DEFAULT_CRON=*/15 * * * *
ODATA_SCHEDULER_ENABLED=true

# --- pagination ---
ODATA_DEFAULT_PAGE_SIZE=50
ODATA_MAX_PAGE_SIZE=1000

# --- пул соединений (только PostgreSQL) ---
ODATA_SQL_ECHO=false
ODATA_DB_POOL_SIZE=5
ODATA_DB_MAX_OVERFLOW=10
ODATA_DB_POOL_RECYCLE=1800
